<?xml version="1.0"?>
<launch>
    <!-- G1 SLAM with RTABMap: ICP odometry from MID360 Lidar + D435 camera for loop closure -->
    <!-- Lidar provides odometry (ICP) and 3D point cloud for mapping.
         Camera provides visual features for loop closure detection only. -->

    <!-- Launch Arguments -->
    <arg name="unite_imu_method" default="2"
         description="0-None, 1-copy, 2-linear_interpolation"/>
    <arg name="args" default=""
         description="Extra arguments for rtabmap and odometry nodes"/>
    <arg name="odom_args" default=""
         description="Extra arguments just for odometry node"/>
    <arg name="localization" default="false"
         description="Launch rtabmap in localization mode (true/false)"/>

    <!-- Enable IR emitter for active depth with color -->
    <set_parameter name="depth_module.emitter_enabled" value="1"/>

    <!-- Static TF: mid360_link -> livox_frame (identity, like d435_link -> camera_link) -->
    <node pkg="tf2_ros" exec="static_transform_publisher"
          args="--x 0 --y 0 --z 0 --yaw 0 --pitch 0 --roll 0 --frame-id mid360_link --child-frame-id livox_frame"/>

    <!-- RealSense D435 Camera Driver -->
    <include file="$(find-pkg-share realsense2_camera)/launch/rs_launch.py">
        <arg name="camera_namespace" value=""/>
        <arg name="enable_gyro" value="true"/>
        <arg name="enable_accel" value="true"/>
        <arg name="unite_imu_method" value="$(var unite_imu_method)"/>
        <arg name="align_depth.enable" value="true"/>
        <arg name="enable_sync" value="true"/>
        <arg name="rgb_camera.profile" value="424x240x30"/>
    </include>

    <!-- ICP Odometry from MID360 Lidar (publishes odom->base_link TF) -->
    <node pkg="rtabmap_odom" exec="icp_odometry" output="screen"
          args="$(var args) $(var odom_args)">
        <param name="frame_id" value="base_link"/>
        <param name="odom_frame_id" value="odom"/>
        <param name="wait_imu_to_init" value="true"/>
        <!-- ICP parameters (type="str" required for RTABMap params in XML) -->
        <param name="Icp/VoxelSize" type="str" value="0.3"/>
        <param name="Icp/MaxCorrespondenceDistance" type="str" value="3.0"/>
        <param name="Icp/PointToPlaneGroundNormalsUp" type="str" value="0.9"/>
        <param name="Icp/RangeMin" type="str" value="0.5"/>
        <param name="Icp/MaxTranslation" type="str" value="1.0"/>
        <param name="OdomF2M/ScanSubtractRadius" type="str" value="0.3"/>
        <param name="OdomF2M/ScanMaxSize" type="str" value="10000"/>
        <param name="Reg/Strategy" type="str" value="1"/>
        <param name="Reg/Force3DoF" type="str" value="true"/>
        <remap from="scan_cloud" to="/livox/lidar"/>
        <remap from="imu" to="/livox/imu/filtered"/>
    </node>

    <!-- RGBD Sync: bundles camera topics for RTABMap loop closure -->
    <node pkg="rtabmap_sync" exec="rgbd_sync" output="screen">
        <param name="approx_sync" value="false"/>
        <remap from="rgb/image" to="/camera/color/image_raw"/>
        <remap from="rgb/camera_info" to="/camera/color/camera_info"/>
        <remap from="depth/image" to="/camera/aligned_depth_to_color/image_raw"/>
    </node>

    <!-- RTABMap SLAM Mode (default) — lidar mapping + camera loop closure -->
    <node pkg="rtabmap_slam" exec="rtabmap" output="screen"
          unless="$(var localization)"
          args="-d $(var args)">
        <param name="frame_id" value="base_link"/>
        <param name="subscribe_depth" value="false"/>
        <param name="subscribe_rgbd" value="true"/>
        <param name="subscribe_scan_cloud" value="true"/>
        <param name="odom_sensor_sync" value="true"/>
        <param name="approx_sync" value="true"/>
        <param name="wait_imu_to_init" value="true"/>
        <param name="topic_queue_size" value="30"/>
        <param name="sync_queue_size" value="30"/>
        <!-- Registration using ICP (lidar) -->
        <param name="Reg/Strategy" type="str" value="1"/>
        <param name="Reg/Force3DoF" type="str" value="true"/>
        <param name="Icp/VoxelSize" type="str" value="0.3"/>
        <param name="Icp/MaxCorrespondenceDistance" type="str" value="3.0"/>
        <param name="Icp/PointToPlaneGroundNormalsUp" type="str" value="0.9"/>
        <param name="Icp/RangeMin" type="str" value="0.5"/>
        <param name="Icp/MaxTranslation" type="str" value="1.0"/>
        <!-- Grid parameters -->
        <param name="Grid/RangeMin" type="str" value="0.5"/>
        <param name="Grid/NormalsSegmentation" type="str" value="false"/>
        <param name="Grid/MaxGroundHeight" type="str" value="0.05"/>
        <param name="Grid/MaxObstacleHeight" type="str" value="2.0"/>
        <param name="Grid/RayTracing" type="str" value="true"/>
        <param name="Grid/3D" type="str" value="false"/>
        <param name="RGBD/OptimizeMaxError" type="str" value="1.5"/>
        <param name="Mem/NotLinkedNodesKept" type="str" value="false"/>
        <remap from="imu" to="/livox/imu/filtered"/>
        <remap from="scan_cloud" to="/livox/lidar"/>
    </node>

    <!-- RTABMap Localization Mode — lidar mapping + camera loop closure -->
    <node pkg="rtabmap_slam" exec="rtabmap" output="screen"
          if="$(var localization)"
          args="$(var args)">
        <param name="frame_id" value="base_link"/>
        <param name="subscribe_depth" value="false"/>
        <param name="subscribe_rgbd" value="true"/>
        <param name="subscribe_scan_cloud" value="true"/>
        <param name="odom_sensor_sync" value="true"/>
        <param name="approx_sync" value="true"/>
        <param name="wait_imu_to_init" value="true"/>
        <param name="topic_queue_size" value="30"/>
        <param name="sync_queue_size" value="30"/>
        <param name="Mem/IncrementalMemory" type="str" value="False"/>
        <param name="Mem/InitWMWithAllNodes" type="str" value="True"/>
        <!-- Registration using ICP (lidar) -->
        <param name="Reg/Strategy" type="str" value="1"/>
        <param name="Reg/Force3DoF" type="str" value="true"/>
        <param name="Icp/VoxelSize" type="str" value="0.3"/>
        <param name="Icp/MaxCorrespondenceDistance" type="str" value="3.0"/>
        <param name="Icp/PointToPlaneGroundNormalsUp" type="str" value="0.9"/>
        <param name="Icp/RangeMin" type="str" value="0.5"/>
        <param name="Icp/MaxTranslation" type="str" value="1.0"/>
        <!-- Grid parameters -->
        <param name="Grid/RangeMin" type="str" value="0.5"/>
        <param name="Grid/NormalsSegmentation" type="str" value="false"/>
        <param name="Grid/MaxGroundHeight" type="str" value="0.05"/>
        <param name="Grid/MaxObstacleHeight" type="str" value="2.0"/>
        <param name="Grid/RayTracing" type="str" value="true"/>
        <param name="Grid/3D" type="str" value="false"/>
        <param name="RGBD/OptimizeMaxError" type="str" value="1.5"/>
        <param name="Mem/NotLinkedNodesKept" type="str" value="false"/>
        <remap from="imu" to="/livox/imu/filtered"/>
        <remap from="scan_cloud" to="/livox/lidar"/>
    </node>

    <!-- RTABMap Visualization -->
    <node pkg="rtabmap_viz" exec="rtabmap_viz" output="screen">
        <param name="frame_id" value="base_link"/>
        <param name="subscribe_depth" value="false"/>
        <param name="subscribe_rgbd" value="true"/>
        <param name="subscribe_scan_cloud" value="true"/>
        <param name="odom_sensor_sync" value="true"/>
        <param name="approx_sync" value="true"/>
        <param name="wait_imu_to_init" value="true"/>
        <param name="topic_queue_size" value="30"/>
        <param name="sync_queue_size" value="30"/>
        <remap from="imu" to="/livox/imu/filtered"/>
        <remap from="scan_cloud" to="/livox/lidar"/>
    </node>

    <!-- IMU Filter for Livox (raw /livox/imu has no orientation, madgwick computes it) -->
    <node pkg="imu_filter_madgwick" exec="imu_filter_madgwick_node" output="screen">
        <param name="use_mag" value="false"/>
        <param name="world_frame" value="enu"/>
        <param name="publish_tf" value="false"/>
        <remap from="imu/data_raw" to="/livox/imu"/>
        <remap from="imu/data" to="/livox/imu/filtered"/>
    </node>

    <!-- Depth Image to LaserScan for Nav2 forward obstacle detection (always active) -->
    <node pkg="depthimage_to_laserscan" exec="depthimage_to_laserscan_node"
          name="depthimage_to_laserscan" output="screen">
        <param name="scan_height" value="10"/>
        <param name="scan_time" value="0.033"/>
        <param name="range_min" value="0.2"/>
        <param name="range_max" value="4.0"/>
        <param name="output_frame" value="camera_link"/>
        <remap from="depth" to="/camera/aligned_depth_to_color/image_raw"/>
        <remap from="depth_camera_info" to="/camera/color/camera_info"/>
        <remap from="scan" to="/camera_scan"/>
    </node>

    <!-- Lidar PointCloud to LaserScan for Nav2 obstacle detection (always active) -->
    <node pkg="pointcloud_to_laserscan" exec="pointcloud_to_laserscan_node"
          name="pointcloud_to_laserscan" output="screen">
        <param name="min_height" value="0.15"/>
        <param name="max_height" value="1.5"/>
        <param name="range_min" value="0.6"/>
        <param name="range_max" value="10.0"/>
        <param name="target_frame" value="base_link"/>
        <remap from="cloud_in" to="/livox/lidar"/>
    </node>
</launch>
