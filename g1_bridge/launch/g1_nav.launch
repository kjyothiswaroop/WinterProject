<?xml version="1.0"?>
<launch>
    <!-- Nav2 Bringup with RViz for Unitree G1 -->
    <include file="$(find-pkg-share nav2_bringup)/launch/g1_nav_launch.py">
        <!-- Navigation Parameters -->
        <arg name="params_file" value="$(find-pkg-share g1_bridge)/config/nav2_params.yaml"/>
        
        <!-- RViz Configuration -->
        <arg name="rviz_config_file" value="$(find-pkg-share nav2_bringup)/rviz/nav2_default_view.rviz"/>
        <arg name="use_rviz" value="True"/>
        
        <!-- Localization Settings - CRITICAL for RTABMap -->
        <arg name="use_localization" value="False"/>
        <arg name="slam" value="False"/>
        <arg name="map" value=""/>
        
        <!-- Simulation and Timing -->
        <arg name="use_sim_time" value="False"/>
        
        <!-- Nav2 Stack Settings -->
        <arg name="autostart" value="True"/>
        <arg name="use_composition" value="True"/>
        <arg name="use_respawn" value="False"/>
        
        <!-- Optional Settings -->
        <arg name="namespace" value=""/>
        <arg name="graph" value=""/>
        <arg name="log_level" value="info"/>
    </include>
</launch>